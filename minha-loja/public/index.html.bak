<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Minha Loja</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1 onclick="location.href='/'">Minha Loja</h1>
    <div class="busca-wrap">
      <input id="busca" type="search" placeholder="Buscar produtos...">
    </div>
    <button id="btn-carrinho">🛒 <span id="qtd-carrinho">0</span></button>
  </header>

  <section class="filtros">
    <div class="categorias" id="categorias"></div>
    <select id="ordem">
      <option value="recentes">Mais recentes</option>
      <option value="menor-preco">Menor preço</option>
      <option value="maior-preco">Maior preço</option>
      <option value="nome">Nome (A-Z)</option>
    </select>
  </section>

  <main id="produtos"></main>

  <div id="modal" class="modal escondido">
    <div class="modal-conteudo">
      <h2>Seu pedido</h2>
      <div id="itens-carrinho"></div>
      <p class="total">Total: <strong id="total">R$ 0,00</strong></p>
      <form id="form-checkout">
        <input name="nome" placeholder="Nome completo" required>
        <input name="email" type="email" placeholder="E-mail" required>
        <input name="telefone" placeholder="WhatsApp (ex: 11999999999)" required>
        <input name="endereco" placeholder="Endereço completo de entrega" required>
        <button type="submit" class="btn-pagar">Gerar Pix</button>
      </form>
      <button id="fechar" class="btn-secundario">Fechar</button>
    </div>
  </div>

  <div id="modal-pix" class="modal escondido">
    <div class="modal-conteudo" style="text-align:center">
      <h2>Pague com Pix</h2>
      <img id="qrcode-img" alt="QR Code Pix" style="width:240px;height:240px;margin:1rem auto;display:block">
      <p>Ou copie o código:</p>
      <textarea id="pix-copia-cola" readonly style="width:100%;height:80px;font-family:monospace;font-size:12px"></textarea>
      <button id="btn-copiar" class="btn-pagar" style="margin-top:.6rem">Copiar código</button>
      <p id="status-pix" style="margin-top:1rem;color:#666">Aguardando pagamento...</p>
    </div>
  </div>

  <script src="app.js"></script>
</body>
</html>
